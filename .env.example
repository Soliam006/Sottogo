# ---------------------------------------------------------------------------
# Supabase (obligatorio)
# Project Settings -> API en https://supabase.com/dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://olqhvcbjwurzirppllnk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Nn2xKKpmXycwn6FNySFN3w_tVsN1aJx

# ---------------------------------------------------------------------------
# Mapas (opcional). Sin valores, la app usa el estilo raster OSM incluido.
# Recomendado en produccion: MapTiler / Stadia / Protomaps.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# ---------------------------------------------------------------------------
# Proveedor de lugares. Valores: "photon" (por defecto) | "google"
# La busqueda se ejecuta SIEMPRE en el servidor: la key nunca llega al cliente.
# ---------------------------------------------------------------------------
PLACES_PROVIDER=photon
PHOTON_ENDPOINT=https://photon.komoot.io
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Tipos de cambio. Valores: "auto" (por defecto) | "frankfurter" | "erapi"
#
#   auto        Banco Central Europeo y, para las divisas que el BCE no publica
#               (guarani, peso argentino, peso chileno, dirham...), la API
#               abierta de exchangerate-api.com. Es lo recomendado.
#   frankfurter Solo BCE. ~30 divisas: las de fuera se quedan sin conversion.
#   erapi       Solo exchangerate-api.com. 160+ divisas, una actualizacion al
#               dia, sin la autoridad del BCE para el euro.
#
# Ninguno de los dos necesita API key.
# ---------------------------------------------------------------------------
EXCHANGE_RATE_PROVIDER=auto
