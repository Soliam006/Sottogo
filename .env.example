# ---------------------------------------------------------------------------
# Mapas (opcional). Sin valores, la app usa el estilo raster OSM incluido.
# Recomendado en produccion: MapTiler / Stadia / Protomaps.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# ---------------------------------------------------------------------------
# Proveedor de lugares. Valores: "photon" (por defecto) | "google"
# La busqueda se ejecuta SIEMPRE en el servidor: la key nunca llega al cliente.
# ---------------------------------------------------------------------------
PLACES_PROVIDER=photon
PHOTON_ENDPOINT=https://photon.komoot.io
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Tipos de cambio. Valores: "frankfurter" (por defecto) | "fixed"
# ---------------------------------------------------------------------------
EXCHANGE_RATE_PROVIDER=frankfurter
